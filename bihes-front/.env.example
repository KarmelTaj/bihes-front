# Copy to `.env.local` only if you need to override the defaults.
#
# Local development needs no env file at all: the app calls `/api/...`, and the
# Vite dev server proxies that to the Django backend (see vite.config.js).

# Where the browser sends API calls. Leave unset for the dev proxy; set it to an
# absolute URL for a deployed build, e.g. https://api.example.com
# VITE_API_BASE_URL=/api

# Where the dev proxy forwards. Override if Django is not on the default port.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
